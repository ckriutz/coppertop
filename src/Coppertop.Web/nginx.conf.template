server {
    listen 80;
    root /usr/share/nginx/html;

    # The browser only talks to this server; nginx forwards /api/* to the Coppertop Api
    # and adds the API key server-side, so the key never reaches the browser.
    location /api/ {
        proxy_pass ${COPPERTOP_API_URL}/;
        proxy_set_header X-Api-Key "${COPPERTOP_API_KEY}";
        proxy_set_header Host $proxy_host;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
